# Copier ce fichier en .env.local et le completer.
# .env.local n'est jamais commite : c'est lui qui porte les vraies valeurs.

# --- Base de donnees ---------------------------------------------------------
# Vide : le site utilise le store fichier local .data/db.json (demo immediate).
# Renseigne : bascule sur MongoDB sans changer une seule page.
MONGODB_URI=
MONGODB_DB=nuanceart

# --- Securite ----------------------------------------------------------------
# Signe le cookie d'administration. DOIT etre une chaine aleatoire longue et
# unique : qui connait cette valeur peut fabriquer un cookie admin valide.
# Generer avec :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Compte administrateur cree par `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Images (Cloudinary) -----------------------------------------------------
# Optionnel en local : sans ces valeurs, les images televersees depuis /admin
# sont ecrites dans public/media/art. Obligatoire sur Vercel ou Render, dont le
# disque est efface a chaque deploiement.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DOSSIER=nuance-art

# --- Coordonnees boutique ----------------------------------------------------
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# --- API ---------------------------------------------------------------------
# Adresse du service Node (dossier serveur/, deploye sur Render). La vitrine
# statique et le script d'instantane l'appellent tous les deux.
NEXT_PUBLIC_API_URL=https://nuance-art-api.onrender.com

# Purge du cache de la vitrine apres chaque ecriture de l'API.
# Meme valeur des deux cotes : REVALIDATION_SECRET sur Vercel et sur Render,
# VITRINE_URL uniquement sur Render (l'adresse publique du site).
VITRINE_URL=http://localhost:3210
REVALIDATION_SECRET=
